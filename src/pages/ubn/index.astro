---
import Base from '../../layouts/Base.astro';
import ToolHead from '../../components/ToolHead.astro';
import Toast from '../../components/Toast.astro';
import { TOOLS } from '../../config/site';

const t = TOOLS.find((x) => x.slug === 'ubn')!;
---
<Base title={t.seoTitle} description={t.seoDescription} path="/ubn/">
  <ToolHead crumb="統一編號" title="統一編號驗證與生成" sub="驗證 8 碼統一編號是否正確，或產生測試用統編。" />

  <div class="tabs" role="tablist" aria-label="功能">
    <button class="tab" role="tab" id="tab-verify" aria-controls="panel-verify" aria-selected="true">驗證</button>
    <button class="tab" role="tab" id="tab-gen" aria-controls="panel-gen" aria-selected="false" tabindex="-1">生成</button>
  </div>

  <section class="panel" id="panel-verify" role="tabpanel" aria-labelledby="tab-verify">
    <form id="verify-form" novalidate>
      <label class="label" for="ubn">統一編號</label>
      <input class="code-input" id="ubn" name="ubn" inputmode="numeric" autocomplete="off" placeholder="12345678" aria-describedby="ubn-hint" />
      <p class="hint" id="ubn-hint">可直接貼上，空白會自動忽略。</p>
      <button class="btn" type="submit">驗證</button>
    </form>
    <div class="slip-slot" id="slot" aria-live="polite">
      <p class="slip-empty">輸入統一編號後，結果會印在這裡。</p>
    </div>
  </section>

  <section class="panel" id="panel-gen" role="tabpanel" aria-labelledby="tab-gen" hidden>
    <div class="count-row">
      <div>
        <label class="label" for="count">數量</label>
        <input class="code-input count" id="count" type="number" min="1" max="10" value="1" inputmode="numeric" />
      </div>
      <button class="btn" id="gen-btn" type="button">生成</button>
    </div>
    <p class="hint">產生符合檢查規則的統編，僅供測試，不代表真實存在的公司。一次最多 10 筆。</p>
    <ul class="gen-list" id="gen-list" hidden></ul>
    <div class="gen-foot" id="gen-foot" hidden>
      <span>每一筆都通過驗證</span>
      <button class="btn btn--ghost" id="copy-all" type="button">全部複製</button>
    </div>
  </section>
  <Toast />
</Base>

<script>
  import { FAILURE_MESSAGE, generateUbns, validateUbn } from '../../lib/ubn';
  import { $, copy, copyButton, el, initTabs, row, slip } from '../../lib/ui';

  initTabs(['verify', 'gen']);

  const input = $<HTMLInputElement>('ubn');
  const slot = $('slot');

  function render() {
    const r = validateUbn(input.value);
    const s = slip('驗證證明聯', !r.ok);
    s.append(el('p', 'slip__code', r.normalized || '--------'), el('hr'));

    const rows = el('dl', 'slip__rows');
    rows.append(row('檢查規則', '加權檢查'), row('位數', String(r.normalized.length)));
    if (r.sum !== undefined) rows.append(row('加權總和', String(r.sum)));
    s.append(rows, el('hr'));

    s.append(el('p', 'slip__verdict', r.ok ? '格式正確' : '不通過'));
    if (!r.ok && r.failure) s.append(el('p', 'slip__reason', FAILURE_MESSAGE[r.failure]));

    if (r.steps) {
      const d = el('details');
      d.append(el('summary', undefined, '計算過程'));
      const t = el('table');
      const head = el('tr');
      for (const h of ['位', '數字', '權重', '積的位數和']) head.append(el('th', undefined, h));
      t.append(head);
      r.steps.forEach((st, i) => {
        const tr = el('tr');
        for (const v of [i + 1, st.digit, st.weight, st.value]) tr.append(el('td', undefined, String(v)));
        t.append(tr);
      });
      d.append(t);
      s.append(d);
    }

    if (r.ok) s.append(el('p', 'slip__note', '格式正確不代表公司真實存在，也不是查核公司登記。'));

    const actions = el('div', 'slip__actions');
    actions.append(
      copyButton('複製結果', () => `統一編號 ${r.normalized}：${r.ok ? '格式正確' : '不通過（' + FAILURE_MESSAGE[r.failure!] + '）'}`),
    );
    s.append(actions);
    slot.replaceChildren(s);
  }

  $('verify-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (input.value.trim() === '') slot.replaceChildren(el('p', 'slip-empty', FAILURE_MESSAGE.empty));
    else render();
  });
  // 輸入到第 8 碼時自動驗證，之前不打擾
  input.addEventListener('input', () => {
    if (validateUbn(input.value).normalized.length === 8) render();
  });

  const list = $('gen-list');
  const foot = $('gen-foot');
  let current: string[] = [];
  $('gen-btn').addEventListener('click', () => {
    current = generateUbns(Number($<HTMLInputElement>('count').value));
    list.replaceChildren(
      ...current.map((code) => {
        const li = el('li');
        li.append(el('span', 'num', code), copyButton('複製', () => code, `複製 ${code}`));
        return li;
      }),
    );
    list.hidden = false;
    foot.hidden = false;
  });
  $('copy-all').addEventListener('click', () => copy(current.join('\n')));
</script>
