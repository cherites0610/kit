---
import Base from '../layouts/Base.astro';
import { SITE, TOOLS } from '../config/site';
---
<Base
  title="台灣線上工具箱"
  description="統一編號驗證、身分證字號、民國年轉換等台灣在地小工具。免登入、開了就能用，資料只在瀏覽器處理。"
>
  <h1 class="page-title">台灣在地小工具</h1>
  <p class="page-sub">{SITE.tagline}</p>

  <label class="search">
    <span class="label">搜尋工具</span>
    <input class="field" id="q" type="search" placeholder="例如：統編、民國年" autocomplete="off" />
  </label>

  <ul class="tool-list" id="list">
    {TOOLS.map((t) => (
      <li data-search={`${t.name} ${t.summary} ${t.keywords}`}>
        {t.status === 'live' ? (
          <a class="tool-row" href={`/${t.slug}/`}>
            <span class="tool-row__main">
              <span class="tool-row__name">{t.name}</span>
              <span class="tool-row__sum">{t.summary}</span>
            </span>
            <span class="tag tag--new">新</span>
            <span class="go" aria-hidden="true">&rarr;</span>
          </a>
        ) : (
          <div class="tool-row tool-row--soon">
            <span class="tool-row__main">
              <span class="tool-row__name">{t.name}</span>
              <span class="tool-row__sum">{t.summary}</span>
            </span>
            <span class="tag tag--soon">即將推出</span>
          </div>
        )}
      </li>
    ))}
  </ul>
  <p class="empty-note" id="none" hidden>找不到工具。換個關鍵字，或清除搜尋看全部。</p>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('#list li')];
  const none = document.getElementById('none')!;
  const list = document.getElementById('list')!;
  q.addEventListener('input', () => {
    const words = q.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const li of items) {
      const hay = (li.dataset.search ?? '').toLowerCase();
      const hit = words.every((w) => hay.includes(w));
      li.hidden = !hit;
      if (hit) shown++;
    }
    none.hidden = shown > 0;
    list.hidden = shown === 0;
  });
</script>
