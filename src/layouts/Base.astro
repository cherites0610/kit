---
import '../styles/global.css';
import { SITE, TOOLS } from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** 404 等不應被收錄的頁面 */
  noindex?: boolean;
}
const { title, description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const fullTitle = `${title}｜${SITE.name}`;
const ogImage = new URL('/og.png', SITE.url).href;
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

// 結構化資料：首頁為 WebSite，工具頁為 WebApplication + BreadcrumbList
const tool = TOOLS.find((t) => `/${t.slug}/` === path);
const jsonLd = noindex
  ? null
  : tool
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'WebApplication',
          name: tool.seoTitle,
          url: canonical,
          description: tool.seoDescription,
          applicationCategory: 'UtilitiesApplication',
          operatingSystem: 'Any',
          browserRequirements: 'Requires JavaScript',
          inLanguage: 'zh-TW',
          isAccessibleForFree: true,
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'TWD' },
          isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
        },
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: '首頁', item: SITE.url + '/' },
            { '@type': 'ListItem', position: 2, name: tool.name, item: canonical },
          ],
        },
      ]
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.name,
        url: SITE.url + '/',
        description: SITE.tagline,
        inLanguage: 'zh-TW',
      };
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#202020" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cherites Kit：台灣在地小工具，畫面為統一編號驗證證明聯" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {umamiSrc && umamiId && <script is:inline defer src={umamiSrc} data-website-id={umamiId}></script>}
  </head>
  <body>
    <header class="topbar">
      <div class="topbar__in">
        <a href="/">{SITE.name}</a>
        <span>台灣工具箱</span>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <p>所有資料只在你的瀏覽器處理，不會送出，也不會被記錄。</p>
    </footer>
  </body>
</html>
